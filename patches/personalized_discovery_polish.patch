+    final id = _normalize(song.id);
+    final artist = _normalize(song.artist);
+    final album = _normalize(song.album);
+    final heardIds = history.map((e) => _normalize(e.song.id)).toSet();
+
+    return !heardIds.contains(id) &&
+        !profile.artists.containsKey(artist) &&
+        !profile.albums.containsKey(album);
+  }
